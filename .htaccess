# Apache / cPanel / LiteSpeed Configuration for Finovision
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www.finovision.net to primary domain https://finovision.net
  RewriteCond %{HTTP_HOST} ^www\.finovision\.net$ [NC]
  RewriteRule ^(.*)$ https://finovision.net/$1 [R=301,L]

  # Redirect finovisionuae.com hosts to https://finovision.net
  RewriteCond %{HTTP_HOST} ^(www\.)?finovisionuae\.com$ [NC]
  RewriteRule ^(.*)$ https://finovision.net/$1 [R=301,L]

  # Redirect any request with .html to clean URL
  RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
  RewriteRule ^ /%1 [NC,L,R=301]

  # Serve .html file internally if it exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
